# CI Environment Configuration for Spec-Based Testing
# This file contains environment-specific settings for GitHub Actions

# Test Execution Settings
TEST_TIMEOUT_MINUTES=30
TEST_RETRY_COUNT=2
TEST_PARALLEL_JOBS=2

# Docker Settings
DOCKER_COMPOSE_FILE=docker-compose.yml
CRAWLAB_STARTUP_TIMEOUT=120
CRAWLAB_API_HEALTH_CHECK_URL=http://localhost:8080/api/health

# API Settings
CRAWLAB_MASTER_URL=http://localhost:8080
CRAWLAB_API_TIMEOUT=30

# Test Result Settings
RESULTS_RETENTION_DAYS=30
ARTIFACT_COMPRESSION=true

# Logging Settings
LOG_LEVEL=INFO
VERBOSE_OUTPUT=true

# Resource Settings
MAX_MEMORY_USAGE_MB=2048
MAX_DISK_USAGE_MB=5120

# Spec Categories and Their Requirements
# Format: CATEGORY_REQUIREMENTS_<CATEGORY>=<docker>,<timeout_minutes>,<retry_count>
CATEGORY_REQUIREMENTS_INFRASTRUCTURE=true,45,2
CATEGORY_REQUIREMENTS_DEPENDENCIES=false,20,1
CATEGORY_REQUIREMENTS_UI=true,30,2

# Test Exclusions (for CI environment)
# Tests that should be skipped in CI due to environment limitations
EXCLUDED_TESTS=manual-interaction,browser-specific,performance-baseline

# Network Settings
NETWORK_TIMEOUT=60
PING_RETRIES=5

# Database Settings (for tests that need DB)
MONGO_TIMEOUT=30
REDIS_TIMEOUT=15